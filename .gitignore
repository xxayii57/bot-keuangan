# =================================================================
# INTIMCLAW — .gitignore (Phase 1A Security Hardening)
# Created: 2026-08-21
# =================================================================

# ===== SECRETS & ENVIRONMENT =====
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
credentials.*.json
token.json
*token*.json
secrets/
known_hosts

# ===== SSH / SHELL HISTORY / PERSONAL DOTFILES =====
.ssh/
.bash_history
.zsh_history
.python_history
.lesshst
.gitconfig
.bashrc
.zshrc
.npmrc
.npm/
.termux/

# ===== CACHES & LOGS =====
.cache/
*.log
logs/

# ===== LOCAL DATABASES (data pribadi/user) =====
# CATATAN: keuangan.db masih ter-track (LEGACY, keputusan untrack di Phase 2)
*.db
*.sqlite
*.sqlite3
*.db-journal

# ===== BUILD ARTIFACTS =====
releases/
dist/
bin/
out/
# CATATAN: IntimClaw_v3.apk masih ter-track (21MB, keputusan untrack di Phase 2)
*.apk

# ===== GO =====
*.test
*.out
vendor/

# ===== NODE (backend/frontend legacy) =====
node_modules/

# ===== PYTHON =====
__pycache__/
*.pyc
.venv/
venv/

# ===== OS / EDITOR JUNK =====
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ===== CHAT LOGS / TRANSCRIPTS (berisi kredensial infra) =====
/undangan-intim/chat_log.jsonl
